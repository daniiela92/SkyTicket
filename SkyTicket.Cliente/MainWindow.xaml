<Window x:Class="SkyTicket.Cliente.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkyTicket.Cliente"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Corpo -->
        </Grid.RowDefinitions>

        <!-- HEADER VERMELHO -->
        <Border Grid.Row="0" Background="#CC0000">
            <TextBlock Text="SkyTicket"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="40,0,0,0"/>
        </Border>

        <!-- CORPO: sidebar + conteúdo -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255"/>
                <!-- Sidebar -->
                <ColumnDefinition Width="*"/>
                <!-- Conteúdo -->
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR VERMELHA -->
            <Grid Grid.Column="0" Background="#CC0000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <Button Content="Aeroportos" Style="{StaticResource MenuButtonStyle}" Click="BtnAeroportos_Click"/>
                    <Button Content="Aviões" Style="{StaticResource MenuButtonStyle}" Click="BtnAvioes_Click"/>
                    <Button Content="Passageiros" Style="{StaticResource MenuButtonStyle}" Click="BtnPassageiros_Click"/>
                    <Button Content="Voos" Style="{StaticResource MenuButtonStyle}" Click="BtnVoos_Click"/>
                    <Button Content="Bilhetes" Style="{StaticResource MenuButtonStyle}" Click="BtnBilhetes_Click"/>
                </StackPanel>

                <Button Grid.Row="1" Content="Créditos"
                        Style="{StaticResource MenuButtonStyle}"
                        FontSize="16"
                        Margin="0,0,0,20"
                        Click="BtnCreditos_Click"/>
            </Grid>

            <!-- ÁREA DE CONTEÚDO (LOGO) -->
            <Border Grid.Column="1" Background="White">
                <Image Source="/Resources/skyticket_logo.png"
                       Stretch="Uniform"
                       Margin="60"/>
            </Border>
        </Grid>
    </Grid>
</Window>
