<Window x:Class="SkyTicket.Client.TicketsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilhetes" Height="700" Width="1050"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CC0000">
            <TextBlock Text="SkyTicket - Bilhetes"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="#CC0000">
                <Button Content="Voltar" Height="50" Margin="15,25,15,10" FontSize="16" Click="BtnBack_Click"/>
            </StackPanel>

            <Grid Grid.Column="1" Background="White" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SELETORES -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Voo" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbFlight" Grid.Column="1" Height="30" SelectedValuePath="Id" SelectionChanged="CmbFlight_SelectionChanged"/>

                    <TextBlock Grid.Column="3" Text="Passageiro" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="CmbPassenger" Grid.Column="4" Height="30" SelectedValuePath="Id"/>
                </Grid>

                <TextBlock x:Name="LabelStatus"
                           Grid.Row="1"
                           Text=""
                           Foreground="Gray"
                           FontStyle="Italic"
                           Margin="0,0,0,10"/>

                <!-- MAPA + TABELA -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- MAPA DE LUGARES -->
                    <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Executiva" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <WrapPanel x:Name="PanelBusinessSeats" Margin="0,0,0,15"/>
                                    <TextBlock Text="Económica" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <WrapPanel x:Name="PanelEconomySeats"/>
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock x:Name="LabelSelectedSeat"
                                       Grid.Row="1"
                                       Text="Nenhum lugar escolhido"
                                       Margin="0,10,0,0"
                                       FontStyle="Italic"
                                       Foreground="Gray"/>

                            <Button x:Name="BtnBuy"
                                    Grid.Row="2"
                                    Content="Comprar"
                                    Height="45"
                                    Margin="0,10,0,0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Background="#43A047"
                                    Foreground="White"
                                    IsEnabled="False"
                                    Click="BtnBuy_Click"/>
                        </Grid>
                    </Border>

                    <!-- TABELA DE BILHETES DO VOO -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Bilhetes deste voo" FontWeight="Bold" Margin="0,0,0,8"/>

                        <DataGrid x:Name="DataGridFlightTickets"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Passageiro" Binding="{Binding PassengerName}" Width="*"/>
                                <DataGridTextColumn Header="Lugar" Binding="{Binding SeatCode}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Grid.Row="2"
                                Content="Cancelar Compra"
                                Height="40"
                                Margin="0,10,0,0"
                                FontWeight="Bold"
                                Background="#E53935"
                                Foreground="White"
                                Click="BtnCancelTicket_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>