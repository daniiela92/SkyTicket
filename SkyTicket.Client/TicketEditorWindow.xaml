<Window x:Class="SkyTicket.Client.TicketEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprar Bilhete" Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        ResizeMode="NoResize">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Comprar Bilhete"
                   FontSize="34"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Passageiro" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="CmbPassenger"
                  Grid.Row="2"
                  Height="30"
                  Margin="150,0,0,0"
                  SelectedValuePath="Id"/>

        <TextBlock Grid.Row="4" Text="Voo" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="CmbFlight"
                  Grid.Row="4"
                  Height="30"
                  Margin="150,0,0,0"
                  SelectedValuePath="Id"
                  SelectionChanged="CmbFlight_SelectionChanged"/>

        <TextBlock Grid.Row="6" Text="Lugar" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="CmbSeat"
                  Grid.Row="6"
                  Height="30"
                  Margin="150,0,0,0"
                  SelectedValuePath="Id"/>

        <TextBlock x:Name="LabelStatus"
                   Grid.Row="7"
                   Text=""
                   Foreground="Red"
                   FontStyle="Italic"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="140" Height="45" FontSize="18" FontWeight="Bold"
                    Background="#E53935" Foreground="White" Margin="0,0,15,0" Click="BtnCancel_Click"/>
            <Button Content="Guardar" Width="140" Height="45" FontSize="18" FontWeight="Bold"
                    Background="#43A047" Foreground="White" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>