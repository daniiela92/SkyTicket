<Window x:Class="SkyTicket.Client.AirplaneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviões" Height="600" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        ResizeMode="NoResize">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
           </Grid.RowDefinitions>

        
        <TextBlock x:Name="LabelTitle"
                   Grid.Row="0"
                   Text=""
                   FontSize="34"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        
        <TextBlock Grid.Row="2" Text="Marca" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtBrand" Grid.Row="2" Height="32" Margin="150,0,0,0" VerticalContentAlignment="Center"/>

        
        <TextBlock Grid.Row="4" Text="Modelo" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtModel" Grid.Row="4" Height="32" Margin="150,0,0,0" VerticalContentAlignment="Center"/>

        
        <TextBlock Grid.Row="6" Text="Lugares Económicos" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtEconomySeats" Grid.Row="6" Height="32" Width="100" HorizontalAlignment="Right" Text="0" VerticalContentAlignment="Center"/>

        
        <TextBlock Grid.Row="8" Text="Lugares Executivos" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtBusinessSeats" Grid.Row="8" Height="32" Width="100" HorizontalAlignment="Right" Text="0" VerticalContentAlignment="Center"/>

        
        <TextBlock x:Name="LabelStatus"
                   Grid.Row="9"
                   Text=""
                   Foreground="Red"
                   FontStyle="Italic"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

        
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    Width="140"
                    Height="45"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#E53935"
                    Foreground="White"
                    Margin="0,0,15,0"
                    Click="BtnCancel_Click"/>

            <Button Content="Guardar"
                    Width="140"
                    Height="45"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="#43A047"
                    Foreground="White"
                    Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
