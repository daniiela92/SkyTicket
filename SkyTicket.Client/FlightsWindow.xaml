<Window x:Class="SkyTicket.Client.FlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voos" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CC0000">
            <TextBlock Text="SkyTicket - Voos"
                       Foreground="White"
                       FontSize="34"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Background="#CC0000">
                <Button Content="Criar" Height="50" Margin="15,25,15,10" FontSize="16" Click="BtnCreate_Click"/>
                <Button Content="Editar" Height="50" Margin="15,10" FontSize="16" Click="BtnEdit_Click"/>
                <Button Content="Pesquisar" Height="50" Margin="15,10" FontSize="16" Click="BtnSearch_Click"/>
                <Button Content="Apagar" Height="50" Margin="15,10" FontSize="16" Click="BtnDelete_Click"/>
                <Button Content="Voltar" Height="50" Margin="15,10" FontSize="16" Click="BtnBack_Click"/>
            </StackPanel>

            <Grid Grid.Column="1" Background="White" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LabelStatus"
                           Grid.Row="0"
                           Text=""
                           Foreground="Gray"
                           FontStyle="Italic"
                           Margin="0,0,0,10"/>

                <DataGrid x:Name="DataGridFlights"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Nº Voo" Binding="{Binding FlightNumber}" Width="100"/>
                        <DataGridTextColumn Header="Aeroporto Origem (Id)" Binding="{Binding DepartureAirportId}" Width="150"/>
                        <DataGridTextColumn Header="Aeroporto Destino (Id)" Binding="{Binding ArrivalAirportId}" Width="150"/>
                        <DataGridTextColumn Header="Avião (Id)" Binding="{Binding AirplaneId}" Width="80"/>
                        <DataGridTextColumn Header="Partida" Binding="{Binding DepartureTime}" Width="*"/>
                        <DataGridTextColumn Header="Chegada" Binding="{Binding ArrivalTime}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>