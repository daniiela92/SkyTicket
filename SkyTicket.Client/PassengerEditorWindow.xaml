<Window x:Class="SkyTicket.Client.PassengerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passageiros" Height="560" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        ResizeMode="NoResize">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LabelTitle"
                   Grid.Row="0"
                   Text=""
                   FontSize="34"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Nome" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtFirstName" Grid.Row="2" Height="32" Margin="150,0,0,0" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Text="Apelido" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtLastName" Grid.Row="4" Height="32" Margin="150,0,0,0" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Text="Telefone" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtPhone" Grid.Row="6" Height="32" Margin="150,0,0,0" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="8" Text="Email" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtEmail" Grid.Row="8" Height="32" Margin="150,0,0,0" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="10" Text="Passaporte" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtPassport" Grid.Row="10" Height="32" Margin="150,0,0,0" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="LabelStatus"
                   Grid.Row="11"
                   Text=""
                   Foreground="Red"
                   FontStyle="Italic"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="140" Height="45" FontSize="18" FontWeight="Bold"
                    Background="#E53935" Foreground="White" Margin="0,0,15,0" Click="BtnCancel_Click"/>
            <Button Content="Guardar" Width="140" Height="45" FontSize="18" FontWeight="Bold"
                    Background="#43A047" Foreground="White" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>