<Window x:Class="SkyTicket.Client.FlightEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voos" Height="620" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        ResizeMode="NoResize">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LabelTitle"
                   Grid.Row="0"
                   Text=""
                   FontSize="34"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Número do Voo" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtFlightNumber" Grid.Row="2" Height="30" Margin="170,0,0,0" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Text="Aeroporto de Origem" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="CmbDepartureAirport"
                  Grid.Row="4"
                  Height="30"
                  Margin="170,0,0,0"
                  SelectedValuePath="Id"/>

        <TextBlock Grid.Row="6" Text="Aeroporto de Destino" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="CmbArrivalAirport"
                  Grid.Row="6"
                  Height="30"
                  Margin="170,0,0,0"
                  SelectedValuePath="Id"/>

        <TextBlock Grid.Row="8" Text="Avião" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="CmbAirplane"
                  Grid.Row="8"
                  Height="30"
                  Margin="170,0,0,0"
                  SelectedValuePath="Id"/>

        <TextBlock Grid.Row="10" Text="Partida (dd/MM/aaaa HH:mm)" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBox x:Name="TxtDepartureTime" Grid.Row="10" Height="30" Margin="230,0,0,0" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="11" Text="Chegada (dd/MM/aaaa HH:mm)" FontSize="16" FontWeight="Bold" Margin="0,10,0,6"/>
        <TextBox x:Name="TxtArrivalTime" Grid.Row="11" Height="30" Margin="230,10,0,0" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="LabelStatus"
                   Grid.Row="12"
                   Text=""
                   Foreground="Red"
                   FontStyle="Italic"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"/>

        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="140" Height="45" FontSize="18" FontWeight="Bold"
                    Background="#E53935" Foreground="White" Margin="0,0,15,0" Click="BtnCancel_Click"/>
            <Button Content="Guardar" Width="140" Height="45" FontSize="18" FontWeight="Bold"
                    Background="#43A047" Foreground="White" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>