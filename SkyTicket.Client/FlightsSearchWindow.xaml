<Window x:Class="SkyTicket.Client.FlightSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pesquisa de Voos" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#CC0000">
            <TextBlock Text="SkyTicket - Pesquisa de Voos"
                       Foreground="White" FontSize="34" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="30,0,0,0"/>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Orientation="Horizontal">
                <StackPanel Margin="0,0,15,10">
                    <TextBlock Text="Origem" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbOrigin" Width="200" Height="30" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,10">
                    <TextBlock Text="Destino" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbDestination" Width="200" Height="30" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,10">
                    <TextBlock Text="Data" FontWeight="Bold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpDate" Width="140" Height="30"/>
                </StackPanel>

                <StackPanel Margin="0,0,15,10">
                    <TextBlock Text="Classe" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbClass" Width="140" Height="30" SelectedIndex="0">
                        <ComboBoxItem Content="Económica"/>
                        <ComboBoxItem Content="Executiva"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,0,15,10">
                    <TextBlock Text="Ordenar por" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbSort" Width="160" Height="30" SelectedIndex="2">
                        <ComboBoxItem Content="Preço"/>
                        <ComboBoxItem Content="Duração"/>
                        <ComboBoxItem Content="Hora de partida"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Pesquisar" Width="120" Height="34" FontWeight="Bold"
                            Background="#43A047" Foreground="White" Margin="0,0,10,0"
                            Click="BtnSearch_Click"/>
                    <Button Content="Voltar" Width="100" Height="34" FontWeight="Bold"
                            Click="BtnBack_Click"/>
                </StackPanel>
            </WrapPanel>

            <TextBlock x:Name="LabelStatus" Grid.Row="1" Text=""
                       Foreground="Gray" FontStyle="Italic" Margin="0,5,0,10"/>

            <DataGrid x:Name="DataGridResults" Grid.Row="2"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nº Voo" Binding="{Binding FlightNumber}" Width="90"/>
                    <DataGridTextColumn Header="Origem" Binding="{Binding Origin}" Width="*"/>
                    <DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="*"/>
                    <DataGridTextColumn Header="Partida" Binding="{Binding Departure}" Width="150"/>
                    <DataGridTextColumn Header="Chegada" Binding="{Binding Arrival}" Width="150"/>
                    <DataGridTextColumn Header="Duração" Binding="{Binding Duration}" Width="90"/>
                    <DataGridTextColumn Header="Tarifa" Binding="{Binding Fare}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>