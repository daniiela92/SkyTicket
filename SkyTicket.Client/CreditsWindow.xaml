<Window x:Class="SkyTicket.Client.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créditos" Height="400" Width="500"
        WindowStartupLocation="CenterScreen">

    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="SkyTicket"
                   FontSize="42" FontWeight="Bold"
                   Foreground="#CC0000"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Sistema de Bilhética Aeronáutica"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,5,0,30"/>

        <TextBlock Text="Autora: Daniela Pais"
                   FontSize="18" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock Text="Curso: CET.TPSI.D.L.107 "
            FontSize="18" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock Text="Versão: 2.0"
                   FontSize="18" HorizontalAlignment="Center" Margin="0,5"/>
        <TextBlock Text="Julho de 2026"
                   FontSize="18" HorizontalAlignment="Center" Margin="0,5"/>
    </StackPanel>
</Window>
